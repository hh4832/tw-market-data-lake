{
  "contract": "tw-market-data-lake backtest data contract",
  "version": "1.2.0-draft",
  "status": "pending_review (B3a / B4a / B5a)",
  "supersedes": null,
  "extends": {"contract": "1.1.0-draft", "quality": "1.0.0",
              "quality_mask_sha256": "9ec79fe02412c25dae56572a334c167c168e374a438dd71e9f4dc0e138ac6863",
              "fubon_5m_seq": 68, "retroactive_changes": false},
  "unknown_is_true": false,
  "multi_day_holding_formal": false,
  "datasets": {
    "corporate_actions_v2": {"location": "derived/corporate_actions_v2/corporate_actions_v2_<run>/", "version": "2.0.0",
      "file": "corporate_actions_v2.parquet", "manifest": "manifest.json",
      "dates": ["official_effective_date", "effective_market_session", "first_observed_trade_date"],
      "price_factor": "ref_price / prev_close",
      "signal_adjusted_price": "raw(t) * prod(price_factor | effective_market_session > t and available_at <= as_of)",
      "execution_price": "raw, never adjusted",
      "available_at": "effective_market_session 08:30 Asia/Taipei (policy)", "source_published_at": null,
      "accounting_status": {"SUPPORTED": "holding allowed", "PRICE_ONLY": "signal adjustment only",
                            "UNSUPPORTED": "no formal use"},
      "research_quarantine": [{"symbol": "8101", "start": "2024-08-22", "end": "2024-12-31",
                               "separate_from": "QUARANTINE_FROZEN_V1"}]},
    "trading_rules": {"location": "derived/trading_rules/trading_rules_<run>/", "version": "1.0.0",
      "file": "trading_rules.parquet", "key": ["symbol", "date"],
      "price_limit_status_usable": ["VERIFIED_OFFICIAL_EVENT", "VERIFIED_OFFICIAL_NEXT_DAY", "NO_LIMIT_VERIFIED",
                                    "NO_LIMIT_OFFICIAL_CLASS", "NO_LIMIT_NEW_LISTING", "DERIVED"],
      "price_limit_status_unusable": ["DERIVED_CONFLICT", "UNKNOWN_INSTRUMENT_CLASS", "UNKNOWN_NO_REFERENCE"],
      "eligibility": ["UNKNOWN", "BLOCKED_NO_TRADE", "BLOCKED_LOCKED_LIMIT_UP", "BLOCKED_LOCKED_LIMIT_DOWN",
                      "CONDITIONAL_LIMIT_TOUCHED", "CONDITIONAL_NO_INTRADAY_RANGE", "ELIGIBLE_SUBJECT_TO_LIQUIDITY"],
      "forward_fill_reference": false,
      "closing_auction": {"start": "13:25", "regular_close": "13:30", "delayed_close_latest": "13:33",
                          "same_auction_from_closing_signal": false,
                          "earliest_after_closing_signal": "next session opening auction, not guaranteed"}},
    "universe_pit": {"location": "audits/universe_pit/universe_pit_<run>/", "version": "1.0.0",
      "files": ["universe_panel.parquet", "universe_symbols.parquet", "coverage_breakdown.csv"],
      "flags": ["official_listed", "official_traded", "halted_official", "finlab_price", "fubon_bars",
                "delisted_official"],
      "last_observed_price_date_is_delisting_date": false, "auto_liquidate_at_last_price": false,
      "valuation_status": ["PRICED", "UNPRICED_HALTED", "UNPRICED_LISTED_NO_TRADE", "UNPRICED_NO_OFFICIAL_ROW",
                           "UNPRICED_NO_SOURCE", "DELISTED_NO_EXIT_PRICE"],
      "aggregate_missing_rate_is_survivorship_proof": false}
  },
  "invalidated_reasons": ["INVALIDATED_CORPORATE_ACTION", "INVALIDATED_LIMIT_UNKNOWN",
                          "INVALIDATED_RESEARCH_QUARANTINE", "INVALIDATED_NO_EXIT_PRICE"],
  "fail_closed": {"manifest_sha_mismatch": "refuse", "no_market_session": "UNSUPPORTED",
                  "fund_like_without_official_limit": "UNKNOWN_INSTRUMENT_CLASS",
                  "no_reference": "UNKNOWN_NO_REFERENCE", "derived_conflict": "UNKNOWN",
                  "official_table_missing": "OFFICIAL_TABLE_MISSING"}
}
